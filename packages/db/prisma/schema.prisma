generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  PRINCIPAL
  ACADEMIC_COORDINATOR
  TEACHER
  ACCOUNTS
  GUARDIAN
  STUDENT
}

enum StudentStatus {
  ACTIVE
  WITHDRAWN
  ALUMNI
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum RecordStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Institution {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  defaultLocale String        @default("en")
  timezone     String         @default("Asia/Dhaka")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  campuses     Campus[]
  memberships  Membership[]
  academicYears AcademicYear[]
  gradeLevels  GradeLevel[]
  sections     Section[]
  students     Student[]
  guardians    Guardian[]
  attendanceSessions AttendanceSession[]
  auditEvents  AuditEvent[]
}

model Campus {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  timezone      String?
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYears AcademicYear[]
  sections      Section[]
  @@unique([institutionId, id])
  @@unique([institutionId, name])
  @@index([institutionId, status])
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  displayName String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  guardians   Guardian[]
  auditEvents AuditEvent[]
}

model Membership {
  id            String         @id @default(cuid())
  institutionId String
  userId        String
  role          MembershipRole
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceSessions AttendanceSession[] @relation("AttendanceRecorder")
  auditEvents   AuditEvent[]
  @@unique([institutionId, userId])
  @@index([userId, active])
  @@index([institutionId, role, active])
}

model AcademicYear {
  id            String       @id @default(cuid())
  institutionId String
  campusId      String?
  name          String
  startsOn      DateTime     @db.Date
  endsOn        DateTime     @db.Date
  isCurrent     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus        Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  sections      Section[]
  @@unique([institutionId, name])
  @@index([institutionId, isCurrent])
}

model GradeLevel {
  id            String       @id @default(cuid())
  institutionId String
  name          String
  sortOrder     Int          @default(0)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  sections      Section[]
  @@unique([institutionId, name])
  @@index([institutionId, sortOrder])
}

model Section {
  id            String       @id @default(cuid())
  institutionId String
  campusId      String?
  academicYearId String
  gradeLevelId  String
  name          String
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus        Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  gradeLevel    GradeLevel   @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  students      Student[]
  attendanceSessions AttendanceSession[]
  @@unique([institutionId, academicYearId, gradeLevelId, name])
  @@index([institutionId, academicYearId, status])
}

model Student {
  id            String        @id @default(cuid())
  institutionId String
  sectionId     String?
  studentNumber String
  firstName     String
  lastName      String
  dateOfBirth   DateTime?     @db.Date
  status        StudentStatus @default(ACTIVE)
  enrolledAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  section       Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  guardianLinks StudentGuardian[]
  attendanceEntries AttendanceEntry[]
  @@unique([institutionId, studentNumber])
  @@index([institutionId, status, lastName, firstName])
  @@index([institutionId, sectionId, status])
}

model Guardian {
  id            String       @id @default(cuid())
  institutionId String
  userId        String?
  fullName      String
  phone         String?
  email         String?
  createdAt     DateTime     @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentLinks  StudentGuardian[]
  @@index([institutionId, fullName])
  @@index([institutionId, phone])
}

model StudentGuardian {
  id          String   @id @default(cuid())
  studentId   String
  guardianId  String
  relationship String
  isPrimary   Boolean  @default(false)
  verifiedAt  DateTime?
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian    Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  @@unique([studentId, guardianId])
  @@index([guardianId, isPrimary])
}

model AttendanceSession {
  id                String             @id @default(cuid())
  institutionId     String
  sectionId         String
  recordedByMembershipId String
  date              DateTime           @db.Date
  status            RecordStatus       @default(DRAFT)
  submittedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  institution       Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  section           Section            @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  recordedBy        Membership         @relation("AttendanceRecorder", fields: [recordedByMembershipId], references: [id], onDelete: Restrict)
  entries           AttendanceEntry[]
  @@unique([institutionId, sectionId, date])
  @@index([institutionId, date, status])
}

model AttendanceEntry {
  id          String           @id @default(cuid())
  sessionId   String
  studentId   String
  status      AttendanceStatus
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([sessionId, studentId])
  @@index([studentId, status])
}

model AuditEvent {
  id            String      @id @default(cuid())
  institutionId String
  actorUserId   String?
  membershipId  String?
  action        String
  entityType    String
  entityId      String
  metadata      Json?
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  actor         User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  membership    Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  @@index([institutionId, createdAt])
  @@index([institutionId, entityType, entityId])
}
