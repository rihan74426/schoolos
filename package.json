{
  "name": "schoolos",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter=@schoolos/web run dev",
    "dev:web": "corepack pnpm --filter=@schoolos/web run dev",
    "dev:mobile": "corepack pnpm --filter=@schoolos/mobile run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "corepack pnpm --filter=@schoolos/core typecheck && corepack pnpm --filter=@schoolos/web typecheck"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.3"
    }
  }
}
